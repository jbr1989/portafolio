---
const linksHeader = [
  {
    text: "Inicio",
    link: "/#inicio",
  },
  {
    text: "Proyectos",
    link: "/#proyectos",
  },
];
---

<header class="site-header">
  <div class="header">
    <a href="/" aria-label="Ir al inicio" class="logo-link">
      <h1 class="site-title">Portafolio</h1>
    </a>
    <nav class="nav" aria-label="Navegación principal">
      <ul class="nav-list" role="list">
        {
          linksHeader.map((link) => (
            <li class="nav-item">
              <a href={link.link}>{link.text}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="menu-toggle-container">
      <button
        class="menu-toggle"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span class="menu-line" id="line1"></span>
        <span class="menu-line" id="line2"></span>
        <span class="menu-line" id="line3"></span>
      </button>
    </div>

    <div class="menu-overlay"></div>
  </div>

  <script>
    const $menu = document.querySelector(".nav");
    const $menuOverlay = document.querySelector(".menu-overlay");
    const $menuToggle = document.querySelector(".menu-toggle");
    const $line1 = document.querySelector("#line1");
    const $line2 = document.querySelector("#line2");
    const $line3 = document.querySelector("#line3");

    function toggleMenu() {
      $line1?.classList.toggle("menu-line--active-1");
      $line2?.classList.toggle("menu-line--active-2");
      $line3?.classList.toggle("menu-line--active-3");
      $menu?.classList.toggle("menu-activado");
      $menuOverlay?.classList.toggle("menu-overlay--active");

      const isOpen = $menu?.classList.contains("menu-activado") ?? false;
      $menuToggle?.setAttribute("aria-expanded", String(isOpen));
      $menuToggle?.setAttribute(
        "aria-label",
        isOpen ? "Cerrar menú de navegación" : "Abrir menú de navegación"
      );
    }

    $menuToggle?.addEventListener("click", toggleMenu);
    $menuOverlay?.addEventListener("click", toggleMenu);
  </script>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(9, 13, 22, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding: 14px 20px;
    transition: all 0.3s ease;
  }

  .header {
    max-width: 1355px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .site-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: #f6f6f9;
    margin: 0;
    letter-spacing: -0.5px;
  }

  .nav {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-item a {
    display: inline-block;
    padding: 8px 16px;
    border-radius: 8px;
    color: #c9d1d9;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .nav-item a:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
  }

  .menu-toggle-container {
    display: none;
  }

  .menu-overlay {
    display: none;
  }

  /* Responsive Mobile Styles */
  @media (max-width: 720px) {
    .menu-overlay {
      display: block;
    }
    .menu-toggle-container {
      display: block;
    }
    .menu-toggle {
      background: none;
      border: none;
      padding: 6px;
      cursor: pointer;
      position: relative;
      z-index: 9999;
    }
    .menu-line {
      display: block;
      position: relative;
      height: 2px;
      width: 26px;
      background-color: #f6f6f9;
      margin-top: 6px;
      cursor: pointer;
      transform-origin: 0px 100%;
      transition: all 0.3s ease;
    }
    .menu-line--active-1 {
      transform: rotate(45deg) translate(0px, 1px);
    }
    .menu-line--active-2 {
      opacity: 0;
      transform: translateX(-15px);
    }
    .menu-line--active-3 {
      transform: rotate(-45deg) translate(0px, -1px);
    }
    .nav {
      position: fixed;
      flex-direction: column;
      background: rgba(13, 17, 23, 0.95);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-left: 1px solid rgba(255, 255, 255, 0.08);
      width: 260px;
      height: 100vh;
      right: -280px;
      top: 0;
      padding-top: 80px;
      transition: right 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 100;
    }

    .nav-item {
      width: 100%;
      padding: 4px 16px;
      box-sizing: border-box;
    }

    .nav-item a {
      width: 100%;
      box-sizing: border-box;
      padding: 12px 16px;
    }

    .nav-item a:hover {
      background: rgba(1, 190, 150, 0.15);
      color: var(--color-primary, #01be96);
    }

    .menu-activado {
      right: 0px;
    }

    .menu-overlay {
      top: 0;
      left: 0;
      position: fixed;
      height: 100vh;
      width: 100%;
      background-color: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(4px);
      z-index: 20;
      visibility: hidden;
      opacity: 0;
      transition: opacity 0.3s ease, visibility 0.3s ease;
      pointer-events: none;
    }
    .menu-overlay--active {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
    }
    .nav-list {
      flex-direction: column;
      width: 100%;
      gap: 4px;
    }
  }
</style>
