---
const linksHeader = [
  {
    text: "Inicio",
    link: "/#inicio",
  },
  {
    text: "Proyectos",
    link: "/#proyectos",
  },
];
---

<header>
  <div class="header">
    <a href="/" aria-label="Ir al inicio">
      <h1>Portafolio</h1>
    </a>
    <nav class="nav" aria-label="Navegación principal">
      <ul class="nav-list" role="list">
        {
          linksHeader.map((link) => (
            <li class="nav-item">
              <a href={link.link}>{link.text}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="menu-toggle-container">
      <button
        class="menu-toggle"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span class="menu-line" id="line1"></span>
        <span class="menu-line" id="line2"></span>
        <span class="menu-line" id="line3"></span>
      </button>
    </div>

    <div class="menu-overlay"></div>
  </div>

  <script>
    const $menu = document.querySelector(".nav");
    const $menuOverlay = document.querySelector(".menu-overlay");
    const $menuToggle = document.querySelector(".menu-toggle");
    const $line1 = document.querySelector("#line1");
    const $line2 = document.querySelector("#line2");
    const $line3 = document.querySelector("#line3");

    function toggleMenu() {
      $line1?.classList.toggle("menu-line--active-1");
      $line2?.classList.toggle("menu-line--active-2");
      $line3?.classList.toggle("menu-line--active-3");
      $menu?.classList.toggle("menu-activado");
      $menuOverlay?.classList.toggle("menu-overlay--active");

      const isOpen = $menu?.classList.contains("menu-activado") ?? false;
      $menuToggle?.setAttribute("aria-expanded", String(isOpen));
      $menuToggle?.setAttribute(
        "aria-label",
        isOpen ? "Cerrar menú de navegación" : "Abrir menú de navegación"
      );
    }

    $menuToggle?.addEventListener("click", toggleMenu);
    $menuOverlay?.addEventListener("click", toggleMenu);
  </script>
</header>

<style>
  .header {
    max-width: 1355px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    overflow: hidden;
  }

  .header h1 {
    display: inline-block;
    position: relative;
    z-index: 20;
    margin: 0;
  }

  .nav {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #f6f6f9;
  }

  .nav-list {
    position: relative;
    display: flex;
    margin: 0;
    padding: 0;
  }

  .nav-list a {
    text-decoration: none;
    color: #f6f6f9;
  }

  .nav-item {
    position: relative;
    list-style: none;
    color: #f6f6f9;
    transition: 0.3s;
    margin: 0 10px;
    padding: 4px 2px;
    text-align: center;
  }

  .nav-item::before {
    content: "";
    position: absolute;
    height: 2px;
    width: 0%;
    background-color: var(--color-primary);
    bottom: -3px;
  }

  .nav-item:hover::before {
    width: 100%;
    transition: 0.4s;
  }

  .nav-item:hover {
    color: var(--color-primary);
  }

  .menu-toggle-container {
    display: none;
  }

  .menu-overlay {
    display: none;
  }
  /* resposive */

  @media (max-width: 720px) {
    .menu-overlay {
      display: block;
    }
    .menu-toggle-container {
      display: block;
    }
    .menu-toggle {
      background: none;
      border: none;
      padding: 0px 20px;
      cursor: pointer;
      position: relative;
      z-index: 9999;
    }
    .menu-line {
      display: block;
      position: relative;
      height: 2px;
      width: 40px;
      background-color: #f6f6f9;
      top: -5px;
      margin-top: 10px;
      cursor: pointer;
      transform-origin: 0px 100%;
      transition: all 0.4s;
    }
    .menu-line--active-1 {
      transform: rotate(40deg) translate(-2px, 1px);
    }
    .menu-line--active-2 {
      opacity: 0;
      margin-left: -30px;
    }
    .menu-line--active-3 {
      transform: rotate(-40deg) translate(-2px, 1px);
    }
    .nav {
      position: fixed;
      flex-direction: column;
      background: #111111;
      width: auto;
      height: 100vh;
      right: -300px;
      top: 80px;
      transition: right 0.4s ease-in-out;
      z-index: 100;
    }

    .nav-item {
      padding: 30px 80px;
      text-align: left;
      width: 100%;
      margin: 0;
    }
    .nav-item:hover {
      background-color: var(--color-primary);
      color: #000;
    }
    .nav-item:hover::before {
      content: "";
      width: 0;
      height: 0;
    }

    .menu-activado {
      right: 0px;
      transition: right 0.4s ease-in-out;
    }
    .menu-overlay {
      top: 0;
      left: 0;
      position: fixed;
      height: 100vh;
      width: 100%;
      background-color: rgba(0, 0, 0, 0.5);
      z-index: 20;
      visibility: hidden;
      opacity: 0;
      transition: opacity 0.3s ease, visibility 0.3s ease;
      pointer-events: none;
    }
    .menu-overlay--active {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
    }
    .nav-list {
      flex-direction: column;
      width: 100%;
    }
  }
</style>
