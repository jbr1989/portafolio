---
import { getCollection } from "astro:content";
import Project from "./ProjectListItem.astro";

const projectEntries = await getCollection("project");
const projects = projectEntries.map((entry) => ({
  id: entry.id,
  ...entry.data,
}));
---

<section class="projects-section" id="proyectos">
  <div class="projects-container">
    <div class="projects-header">
      <div class="header-left">
        <span class="section-tag">Portafolio</span>
        <h2 class="projects-title">Proyectos Destacados</h2>
      </div>

      <a
        href="https://audit.jbr1989.es/latest.html"
        target="_blank"
        rel="noopener noreferrer"
        class="audit-badge"
        aria-label="Ver informe de auditoría de seguridad"
      >
        <span class="audit-pulse"></span>
        <svg
          width="14"
          height="14"
          viewBox="0 0 16 16"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="audit-icon"
        >
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M7.99987 0C4.51999 0 2.64511 0.251378 1.66269 0.474311C0.821079 0.664889 0.342137 1.37244 0.252892 2.13262C0.0773862 3.65428 -0.00691392 5.18507 0.000442898 6.7168C0.0199988 10.138 1.82981 13.3365 4.87626 14.9493C5.42169 15.238 5.9753 15.4972 6.49762 15.6853C7.01354 15.8713 7.53301 16 7.99987 16C8.46672 16 8.98619 15.8713 9.50176 15.6853C10.0244 15.4972 10.578 15.238 11.1231 14.9493C14.1699 13.3365 15.9797 10.138 15.9993 6.7168L16 6.50667C16 4.6464 15.8574 3.072 15.7468 2.13262C15.6579 1.3728 15.1779 0.664889 14.337 0.474311C13.3546 0.251378 11.4797 0 7.99987 0Z"
            fill="currentColor"
          ></path>
        </svg>
        <span>Security Audit</span>
      </a>
    </div>

    <ul class="projects-grid">
      {
        projects.map(
          ({ id, descr, img, link, technologies, title, code }) => (
            <Project
              project_id={id}
              img={img}
              descr={descr}
              link={link}
              title={title}
              technologies={technologies}
              code={code}
            />
          )
        )
      }
    </ul>
  </div>
</section>

<style>
  .projects-section {
    position: relative;
    padding: 3rem 0 5rem 0;
    scroll-margin-top: 80px;
  }

  .projects-container {
    width: 90%;
    max-width: 1280px;
    margin: 0 auto;
  }

  .projects-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    flex-wrap: wrap;
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .section-tag {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 700;
    color: var(--color-primary, #01be96);
  }

  .projects-title {
    font-size: 2.2rem;
    font-weight: 800;
    margin: 0;
    color: #f6f6f9;
    letter-spacing: -0.5px;
  }

  .audit-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    color: #93c5fd;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.25);
    transition: all 0.2s ease;
  }

  .audit-badge:hover {
    background: rgba(59, 130, 246, 0.2);
    border-color: rgba(59, 130, 246, 0.5);
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(59, 130, 246, 0.2);
  }

  .audit-pulse {
    width: 6px;
    height: 6px;
    background-color: #60a5fa;
    border-radius: 50%;
    box-shadow: 0 0 8px #60a5fa;
  }

  .audit-icon {
    color: #60a5fa;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    padding: 2.5rem 0 0 0;
    margin: 0;
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .projects-title {
      font-size: 1.8rem;
    }
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
