---
import { marked } from "marked";
import * as github from "../../utils/github";
import { getCollection } from "astro:content";

import Layout from "../../layouts/Layout.astro";
import TechnologyList from "../../components/technologies/TechnologyList.astro";
import NotepadWindow from "../../components/NotepadWindow.astro";

export async function getStaticPaths() {
  const projects = await getCollection("project");
  return projects.map((entry) => ({
    params: { id: entry.id },
    props: { project: { id: entry.id, ...entry.data } },
  }));
}

const renderer = {
  heading({ tokens, depth }) {
    const newLevel = Math.min(depth + 1, 6);

    const text = this.parser.parseInline(tokens);
    const escapedText = text.toLowerCase().replace(/[^\w]+/g, "-");

    return `<h${newLevel}>${text}</h${newLevel}>`;
  },
};

const { id } = Astro.params;
const { project } = Astro.props;

const readme =
  (await github.getReadme(project.repository)) ||
  "<p>No hay README disponible</p>";

marked.use({ renderer });
const htmlReadme = marked.parse(readme);
---

<Layout
  title={`${project.title} — Jaime Balagué`}
  description={`${project.descr} — Proyecto de ${project.title}`}
  image={project.img}
  type="article">
  <div id="proyecto-info" class="container">
    <img src={project.img} alt={`Captura del proyecto ${project.title}`} loading="lazy" width="600" height="400" />

    <div>
      <h2>{project.title}</h2>

      

      <div>
        {
          project.link ? (
            <a href={project.link} target="_blank" rel="noopener noreferrer" class="link-button">
              Ver más
            </a>
          ) : null
        }
        {
          project.code ? (
            <a href={project.code} target="_blank" rel="noopener noreferrer" class="link-button">
              Ver código
            </a>
          ) : null
        }
      </div>

      <p>{project.descr}</p>

      
      <div>
        Tecnologías usadas:
        <TechnologyList technologies={project.technologies} />
      </div>
      
    </div>
  </div>
  <div class="container">

    <NotepadWindow title="README.md">
      <div set:html={htmlReadme} />
    </NotepadWindow>
  </div>
</Layout>

<style>
  h2 {
    text-align: center;
    margin-top: 20px;
    margin-bottom: 50px;
  }

  #proyecto-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-top: 3em;
  }

  #proyecto-info > div {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
</style>
