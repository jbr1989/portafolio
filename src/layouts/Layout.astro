---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = "Jaime Balagué",
  description = "Portafolio de Jaime Balagué — Ingeniero Informático",
  image = "/img/perfil.webp",
  type = "website"
} = Astro.props;

const siteUrl = "https://jbr1989.es";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

import Header from "../components/Header.astro";
import "../styles/normalize.css";
import "../styles/styles.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="author" content="Jaime Balagué" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${image}`} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Jaime Balagué" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${image}`} />

    <script
      type="module"
      data-entity="portafolio"
      async
      src="https://info.jbr1989.es/script.js"></script>
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">Saltar al contenido</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  html {
    font-size: 18px;
    font-weight: 400;
    line-height: 24px;
    color-scheme: light dark;
    font-family:
      "Open Sans", "HelveticaNeue", "Helvetica Neue", Helvetica, Arial,
      sans-serif;
  }

  body {
    min-height: 100vh;
    background-color: #121212;
    color: var(--color-text);
  }

  body > header {
    position: relative;
    background-color: #000;
    padding: 20px 20px;
    color: #f6f6f9;
  }

  main {
    margin-bottom: 50px;
  }

  .skip-to-content {
    position: absolute;
    top: -100%;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: #000;
    padding: 8px 16px;
    z-index: 9999;
    border-radius: 0 0 4px 4px;
    font-weight: 600;
    text-decoration: none;
    transition: top 0.2s;
  }

  .skip-to-content:focus {
    top: 0;
  }
</style>
