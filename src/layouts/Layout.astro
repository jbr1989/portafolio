---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = "Jaime Balagué",
  description = "Portafolio de Jaime Balagué — Ingeniero Informático",
  image = "/img/perfil.webp",
  type = "website"
} = Astro.props;

const siteUrl = "https://jbr1989.es";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

import Header from "../components/Header.astro";
import "../styles/normalize.css";
import "../styles/styles.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="author" content="Jaime Balagué" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${image}`} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Jaime Balagué" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${image}`} />

    <script
      type="module"
      data-entity="portafolio"
      async
      src="https://info.jbr1989.es/script.js"></script>
  </head>
  <body>
    <!-- Fondo ambiental moderno: Aurora mesh & subtle grid -->
    <div class="ambient-background" aria-hidden="true">
      <div class="glow-orb orb-primary"></div>
      <div class="glow-orb orb-secondary"></div>
      <div class="glow-orb orb-tertiary"></div>
      <div class="grid-pattern"></div>
    </div>

    <a href="#main-content" class="skip-to-content">Saltar al contenido</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  html {
    font-size: 18px;
    font-weight: 400;
    line-height: 24px;
    color-scheme: dark;
    font-family:
      "Open Sans", "HelveticaNeue", "Helvetica Neue", Helvetica, Arial,
      sans-serif;
    background-color: #0b0f17;
    overflow-x: hidden;
  }

  body {
    min-height: 100vh;
    color: var(--color-text, #f6f6f9);
    position: relative;
    background: transparent;
    overflow-x: hidden;
  }

  /* Fondo ambiental: Aurora Mesh y Rejilla sutil */
  .ambient-background {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background-color: #090d16;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.18;
    will-change: transform;
    pointer-events: none;
  }

  .orb-primary {
    top: -15%;
    left: 20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, #01be96 0%, rgba(1, 190, 150, 0) 70%);
    animation: floatPrimary 18s ease-in-out infinite alternate;
  }

  .orb-secondary {
    top: 40%;
    right: -10%;
    width: 550px;
    height: 550px;
    background: radial-gradient(circle, #3b82f6 0%, rgba(59, 130, 246, 0) 70%);
    opacity: 0.13;
    animation: floatSecondary 22s ease-in-out infinite alternate;
  }

  .orb-tertiary {
    bottom: -15%;
    left: 10%;
    width: 650px;
    height: 650px;
    background: radial-gradient(circle, #0d9488 0%, rgba(13, 148, 136, 0) 70%);
    opacity: 0.12;
    animation: floatTertiary 20s ease-in-out infinite alternate;
  }

  .grid-pattern {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(circle at 50% 30%, black 40%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at 50% 30%, black 40%, transparent 80%);
  }

  @keyframes floatPrimary {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(60px, 80px) scale(1.1); }
  }

  @keyframes floatSecondary {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(-80px, 60px) scale(1.15); }
  }

  @keyframes floatTertiary {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(50px, -60px) scale(1.08); }
  }

  main {
    margin-bottom: 50px;
    position: relative;
    z-index: 1;
  }

  .skip-to-content {
    position: absolute;
    top: -100%;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: #0b0f19;
    padding: 8px 16px;
    z-index: 9999;
    border-radius: 0 0 8px 8px;
    font-weight: 600;
    text-decoration: none;
    transition: top 0.2s;
  }

  .skip-to-content:focus {
    top: 0;
  }
</style>
