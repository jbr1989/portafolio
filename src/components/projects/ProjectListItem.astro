---
import TechnologyList from "../technologies/TechnologyList.astro";
import InfoIcon from "../../assets/icons/info.svg";
import GithubIcon from "../../assets/icons/github.svg";
import WebsiteIcon from "../../assets/icons/website.svg";

export interface Props {
  project_id: string;
  title: string;
  img: string;
  descr: string;
  technologies?: string[];
  link: string;
  code: string;
}

const { project_id, technologies, title, img, descr, link, code } = Astro.props;
---

<li class="project-card-item">
  <article class="project-card">
    <!-- Glow hover border effect -->
    <div class="card-glow-overlay" aria-hidden="true"></div>

    <!-- Image preview with overlay -->
    <div class="card-image-container">
      <img
        src={img}
        alt={`Captura del proyecto ${title}`}
        loading="lazy"
        width="380"
        height="210"
        class="card-image"
      />
      <div class="image-gradient-overlay" aria-hidden="true"></div>
    </div>

    <!-- Content body -->
    <div class="card-body">
      <h3 class="card-title">{title}</h3>
      <p class="card-description">{descr}</p>

      {technologies && technologies.length > 0 && (
        <div class="technologies-wrapper">
          <span class="tech-label">Stack:</span>
          <div class="tech-icons">
            <TechnologyList technologies={technologies} />
          </div>
        </div>
      )}
    </div>

    <!-- Action buttons footer -->
    <footer class="card-actions">
      <a
        href={`/proyecto/${project_id}`}
        class="btn-card primary"
        aria-label={`Ver detalles e información de ${title}`}
      >
        <InfoIcon class="btn-card-icon" aria-hidden="true" />
        <span>Detalles</span>
      </a>

      {code ? (
        <a
          href={code}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-card secondary"
          aria-label={`Ver código fuente de ${title} en GitHub`}
          title="Ver código fuente"
        >
          <GithubIcon class="btn-card-icon" aria-hidden="true" />
          <span>Código</span>
        </a>
      ) : null}

      {link ? (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-card secondary"
          aria-label={`Visitar sitio web del proyecto ${title}`}
          title="Visitar sitio"
        >
          <WebsiteIcon class="btn-card-icon" aria-hidden="true" />
          <span>Demo</span>
        </a>
      ) : null}
    </footer>
  </article>
</li>

<style>
  .project-card-item {
    list-style: none;
    width: 100%;
    display: flex;
  }

  .project-card {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: rgba(18, 24, 38, 0.65);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.35s ease,
                box-shadow 0.35s ease;
  }

  .card-glow-overlay {
    position: absolute;
    inset: 0;
    border-radius: 16px;
    background: radial-gradient(
      600px circle at var(--mouse-x, 50%) var(--mouse-y, 0%),
      rgba(1, 190, 150, 0.12),
      transparent 40%
    );
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
    z-index: 2;
  }

  .project-card:hover {
    transform: translateY(-8px);
    border-color: rgba(1, 190, 150, 0.4);
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.7),
                0 0 25px rgba(1, 190, 150, 0.15);
  }

  .project-card:hover .card-glow-overlay {
    opacity: 1;
  }

  .card-image-container {
    position: relative;
    width: 100%;
    height: 190px;
    overflow: hidden;
    background: #090d16;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover .card-image {
    transform: scale(1.06);
  }

  .image-gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 50%,
      rgba(18, 24, 38, 0.95) 100%
    );
    pointer-events: none;
  }

  .card-body {
    padding: 1.25rem 1.4rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 0.75rem;
    position: relative;
    z-index: 1;
  }

  .card-title {
    color: #f6f6f9;
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.3px;
  }

  .card-description {
    color: #94a3b8;
    font-size: 0.93rem;
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .technologies-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .tech-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #64748b;
  }

  .tech-icons {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
  }

  .card-actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
    gap: 8px;
    padding: 0.9rem 1.25rem;
    background: rgba(10, 14, 23, 0.5);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    position: relative;
    z-index: 3;
  }

  .btn-card {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 10px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-card.primary {
    background: rgba(1, 190, 150, 0.15);
    color: #01be96;
    border: 1px solid rgba(1, 190, 150, 0.3);
  }

  .btn-card.primary:hover {
    background: #01be96;
    color: #0b0f19;
    box-shadow: 0 4px 12px rgba(1, 190, 150, 0.35);
  }

  .btn-card.secondary {
    background: rgba(255, 255, 255, 0.04);
    color: #cbd5e1;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .btn-card.secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .btn-card-icon {
    width: 14px;
    height: 14px;
    fill: currentColor;
    flex-shrink: 0;
  }
</style>
