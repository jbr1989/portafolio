---
import TechnologyList from "../technologies/TechnologyList.astro";
import InfoIcon from "../../assets/icons/info.svg";
import GithubIcon from "../../assets/icons/github.svg";
import WebsiteIcon from "../../assets/icons/website.svg";

export interface Props {
  project_id: string;
  title: string;
  img: string;
  descr: string;
  technologies?: string[];
  link: string;
  code: string;
}

const { project_id, technologies, title, img, descr, link, code } = Astro.props;
---

<li class="project-card">
  <img src={img} alt={`Captura del proyecto ${title}`} loading="lazy" width="380" height="200" />
  <p class="project-title">{title}</p>
  <p class="project-description">
    {descr}
  </p>
  <div class="technologies">
    <TechnologyList technologies={technologies || []} />
  </div>
  <div class="project-links">
    <a href={`/proyecto/${project_id}`} aria-label={`Ver información de ${title}`} title="Ver información">
      <InfoIcon
        class="icon-technology"
        aria-hidden="true"
        style="fill:white;"
      />
    </a>
    {
      code ? (
        <a href={code} target="_blank" rel="noopener noreferrer" aria-label={`Ver código de ${title} en GitHub`} title="Ver código">
          <GithubIcon
            class="icon-technology"
            aria-hidden="true"
            style="fill:white;"
          />
        </a>
      ) : null
    }
    {
      link ? (
        <a href={link} target="_blank" rel="noopener noreferrer" aria-label={`Ver proyecto ${title}`} title="Ver proyecto">
          <WebsiteIcon
            class="icon-technology"
            aria-hidden="true"
            style="fill:white;"
          />
        </a>
      ) : null
    }
  </div>
</li>

<style>
  .project-card {
    position: relative;
    list-style: none;
    border: 1px solid var(--color-card-border);
    overflow: hidden;
    max-width: 380px;
    min-width: 300px;
    width: 100%;
    transition: transform, box-shadow, 0.3s;
    border-radius: 7px;
    background-color: var(--color-card-bg);
    z-index: 1;
    min-height: 100%;
    display: flex;
    justify-content: space-between;
    flex-direction: column;
  }

  .project-card::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 5px;
    z-index: -1;
    bottom: 0;
    transition: 0.3s ease-in-out;
    pointer-events: none;
  }

  .project-card:hover::before {
    content: "";
    position: absolute;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.3);
    z-index: -1;
    bottom: 0;
    transition: 0.3s ease-in-out;
    pointer-events: none;
  }
  .project-card:hover {
    transform: translateY(-10px);
  }
  .project-card > img {
    position: relative;
    display: block;
    height: 200px;
    width: 100%;
    object-fit: cover;
    object-position: left top;
    user-select: none;
    pointer-events: none;
  }
  .project-title {
    color: var(--color-text);
    padding: 10px 5px 10px 10px;
    margin: 0;
    font-size: 25px;
    font-weight: 700;
  }
  .project-title::first-letter {
    text-transform: capitalize;
  }

  .project-description {
    padding: 0 10px;
    color: var(--color-text-muted);
    font-size: 17px;
    font-weight: 400;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .project-description::first-letter {
    text-transform: capitalize;
  }

  .technologies {
    position: relative;
    display: flex;
    justify-content: start;
    padding: 0 10px;
    column-gap: 20px;
    flex-wrap: wrap;
    color: white;
  }

  .project-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: 100%;
    justify-content: space-between;
    justify-items: stretch;
    align-items: stretch;
    position: relative;
    text-align: center;
    margin-top: 2em;
  }
  .project-links > a {
    background: rgba(0, 0, 0, 0.3);
    display: grid;
    align-items: center;
    justify-items: center;
    padding: 1em;
  }

  .project-links > a:hover {
    background: #002f624f;
  }

  .project-links img {
    display: inline-block;
  }
</style>
