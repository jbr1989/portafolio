---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = "Jaime Balagué",
  description = "Portafolio de Jaime Balagué — Ingeniero Informático",
  image = "/img/perfil.webp",
  type = "website"
} = Astro.props;

const siteUrl = "https://jbr1989.es";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

import Header from "../components/Header.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="author" content="Jaime Balagué" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${image}`} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Jaime Balagué" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${image}`} />

    <link rel="stylesheet" href="/css/normalize.css" />
    <link rel="stylesheet" href="/css/styles.css" />

    <script
      type="module"
      data-entity="portafolio"
      async
      src="https://info.jbr1989.es/script.js"></script>
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  /* @font-face {
    font-family: "Open Sans";
    src: url("fonts/open-sans-v34-vietnamese_latin-ext_latin_hebrew_greek-ext_greek_cyrillic-ext_cyrillic-regular.woff2")
      format("woff2");
  } */

  html {
    font-size: 18px;
    font-weight: 400;
    line-height: 24px;
    color-scheme: light dark;
    font-family:
      "Open Sans", "HelveticaNeue", "Helvetica Neue", Helvetica, Arial,
      sans-serif;
  }

  body {
    min-height: 100vh;
    /* display:grid;
		align-items: center;
		justify-content: center; */
  }

  body > header {
    position: relative;
    background-color: #000;
    padding: 20px 20px;
    color: #f6f6f9;
  }

  main {
    margin-bottom: 50px;
  }

</style>
