---
export interface Props {
  title?: string;
}

const { title = "README.md" } = Astro.props;
---

<div class="code-window">
  <div class="code-window-titlebar">
    <div class="window-controls">
      <span class="control-dot close" aria-hidden="true"></span>
      <button type="button" class="control-dot minimize btn-minimize" aria-label="Minimizar ventana"></button>
      <button type="button" class="control-dot maximize btn-maximize" aria-label="Maximizar ventana"></button>
    </div>
    <div class="window-tab">
      <svg class="file-icon" viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
        <path d="M0 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2h2a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2H2a2 2 0 0 1-2-2V2zm2-1a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H2z"/>
      </svg>
      <span class="window-title">{title}</span>
    </div>
    <div class="titlebar-actions">
      <span class="badge-preview">Markdown Preview</span>
    </div>
  </div>

  <div class="code-window-body">
    <slot />
  </div>
</div>

<script>
  function setupCodeWindows() {
    document.querySelectorAll(".code-window").forEach((windowEl) => {
      const minimizeBtn = windowEl.querySelector(".btn-minimize");
      const maximizeBtn = windowEl.querySelector(".btn-maximize");

      minimizeBtn?.addEventListener("click", () => {
        windowEl.classList.toggle("code-window--collapsed");
      });

      maximizeBtn?.addEventListener("click", () => {
        windowEl.classList.toggle("code-window--maximized");
      });
    });
  }

  setupCodeWindows();
  document.addEventListener("astro:page-load", setupCodeWindows);
</script>

<style>
  .code-window {
    margin-top: 2rem;
    background: #0d1117;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.05);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .code-window--maximized {
    height: 75vh;
    display: flex;
    flex-direction: column;
  }

  .code-window--maximized .code-window-body {
    flex: 1;
    overflow: auto;
  }

  .code-window--collapsed .code-window-body {
    display: none;
  }

  .code-window-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: #161b22;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    user-select: none;
  }

  .window-controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .control-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .control-dot:hover {
    transform: scale(1.15);
  }

  .control-dot.close {
    background: #ff5f56;
    cursor: default;
  }

  .control-dot.minimize {
    background: #ffbd2e;
  }

  .control-dot.maximize {
    background: #27c93f;
  }

  .window-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #0d1117;
    padding: 4px 12px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: #c9d1d9;
    font-size: 0.82rem;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
  }

  .file-icon {
    color: var(--color-primary, #01be96);
  }

  .window-title {
    font-weight: 500;
  }

  .titlebar-actions {
    display: flex;
    align-items: center;
  }

  .badge-preview {
    font-size: 0.72rem;
    color: #8b949e;
    background: rgba(255, 255, 255, 0.04);
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .code-window-body {
    padding: 2rem 2.5rem;
    background: #0d1117;
    color: #e6edf3;
    line-height: 1.7;
    font-size: 0.95rem;
  }

  @media (max-width: 600px) {
    .code-window-body {
      padding: 1.25rem;
    }
    .badge-preview {
      display: none;
    }
  }
</style>
